            "value": "flex AND NOT grid"
          }
        },
        {
          "cmd": "lucivy search --phrase \"async function\"",
          "note": "these two words, adjacent, in this order",
          "query": {
            "type": "phrase",
            "field": "content",
            "value": "async function"
          }
